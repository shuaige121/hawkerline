# Copy to .print-agent.env on the kitchen computer. Do not commit the real file.
# Password mode is easier for kitchen computers; token URL still works.
HL_PRINT_BASE_URL="https://your-store.example"
HL_KITCHEN_PASSWORD="replace-with-kitchen-password"
# HL_KITCHEN_URL="https://your-store.example/kitchen?t=kp_xxx"

# GP-3120TN / Gprinter 3-inch label printer.
HL_PRINT_MODE="tspl"
HL_PRINT_PRINTER="GP-3120TN"
HL_TSPL_WIDTH_MM="76"
HL_TSPL_HEIGHT_MM="120"
HL_TSPL_GAP_MM="0"
HL_TSPL_COLS="32"
HL_TSPL_CODEPAGE="UTF-8"
HL_TSPL_ENCODING="utf8"

# If Chinese text is garbled on this printer firmware, try:
# HL_TSPL_CODEPAGE="936"
# HL_TSPL_ENCODING="gb18030"

# If the printer is exposed as a serial device instead of a CUPS/Windows printer,
# use HL_PRINT_DEVICE instead of HL_PRINT_PRINTER.
# macOS example: HL_PRINT_DEVICE="/dev/cu.usbserial-xxxx"
# Linux example: HL_PRINT_DEVICE="/dev/usb/lp0"
# HL_PRINT_BAUD="9600"
